# Settings this repo reads. Copy to .Renviron (R reads it at startup) or export
# them in your shell; never commit the filled-in copy.

# NEON API token, created under your account at data.neonscience.org. NEON
# data endpoints refuse anonymous requests. In GitHub Actions it is the
# NEON_TOKEN repository secret.
NEON_TOKEN=

# CARTO basemap key (optional, read by the app at runtime). On Posit Connect
# Cloud it is a content variable, not a repo secret.
CARTO_BASEMAP_KEY=

# Optional build settings, with their defaults. Leave them unset unless you
# rebuild the bundles by hand (README, "Rebuild").
# PHE_LIVE=0                        # 1 lets the app fetch live NEON data; the release boots from bundles
# PHE_STARTDATE=2016-01             # first month fetched (YYYY-MM); 2013-2015 are deferred
# PHE_ENDDATE=                      # last month fetched (YYYY-MM); default the current month
# PHE_RAW_OUT_DIR=../phe-data-fetch # where fetch_all_phe.R writes raw site files
# PHE_RAW_DIR=../phe-data-fetch     # where bundle_phe_data.R reads them
